entrypoint = "README.md"
modules = ["nodejs-22", "node", "python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["openjdk17", "p7zip"]

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "npm run expo:static:build && npm run server:build"]
run = ["npm", "run", "server:prod"]
publicDir = "public"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5060
externalPort = 5173

[[ports]]
localPort = 5904
externalPort = 3000

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 23636
externalPort = 3001

[env]
PORT = "5000"

[agent]
stack = "EXPO"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "prod-backend-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dev-backend-build"

[[workflows.workflow]]
name = "Start App"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Frontend"

[[workflows.workflow]]
name = "Start Backend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Frontend"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run expo:dev"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "prod-backend-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd shib-mine-backend && npm run server:build && rm -rf server_dist"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "dev-backend-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run server:build && rm -rf server_dist"

[workflows.workflow.metadata]
isValidation = true

[userenv]

[userenv.shared]
SMTP_FROM = "support@shibahit.com"
EXPO_PUBLIC_BREVO_API_KEY = "xsmtpsib-57d87a3812ae04a7addce247e7bb94c093e2fbc9e18524fdd25eced8f3762011-JyPzK9RXNM1BUrIj"
PORT = "5000"
SERVER_PORT = "5000"
EXPO_PUBLIC_RAILWAY_URL = "https://shib-mine-backend-production.up.railway.app"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
