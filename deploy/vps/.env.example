# Copy this file to .env and fill in the values, then: chmod 600 .env
NODE_ENV=production
PORT=3001

# PocketBase admin credentials (same ones Railway uses)
PB_ADMIN_EMAIL=your-pb-admin@email.com
PB_ADMIN_PASSWORD=your-pb-admin-password

# Match-signature signing key — REQUIRED. Any long random string.
# Generate one with:  openssl rand -hex 32
# NEVER change it after launch (in-flight game sessions would be rejected).
SESSION_SECRET=

# Brevo SMTP (optional — only for OTP emails via Express)
SMTP_USER=
SMTP_KEY=

# Optional: proxy/VPN detection
# PROXYCHECK_API_KEY=
