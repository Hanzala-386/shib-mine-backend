[Unit]
Description=Shiba Hit backend (thin gateway)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/shib-backend
EnvironmentFile=/opt/shib-backend/.env
ExecStart=/usr/bin/node /opt/shib-backend/server.cjs
Restart=always
RestartSec=3
User=www-data
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
